# ---------------------------------------------------------------------------
# BaseRow — primary data source for NEW ARRIVAL, ALL-KITS and RETRO.
# 1. Table id is the number in the table URL:
#    https://baserow.io/workspace/{id}/database/{db}/table/{VITE_BASEROW_TABLE_ID}
# 2. Avatar menu -> Menu -> API -> copy the database token.
# 3. Use the API host below. baserow.io serves the web app and returns 404 for /api/*.
# 4. Column names are matched case/space-insensitively. Recognised:
#    Jersey Name | Name | Kit Name | Title
#    Price | Amount | Cost
#    Sizes | Size            (multi-select or text "S, M, L")
#    In Stock | Stock | Available | Status   (checkbox, or yes/no / in stock / sold out)
#    Is New | New | New Arrival            (flags the NEW ARRIVAL carousel)
#    Retro | Vintage                       (optional; retro is otherwise read
#                                           from the season in the name: 1998, 98/99,
#                                           1996-97, 2025/26 ... older than this year)
#    Club | Team                           (optional, groups related products)
#    Image | Photo | Picture               (File column; extra files become the gallery)
# 5. Restart the dev server after editing .env.local.
# WARNING: the token is bundled into the client. Scope it to this one table, or
# move these calls behind a serverless proxy before real production use.
VITE_BASEROW_URL=https://api.baserow.io
VITE_BASEROW_API_KEY=
VITE_BASEROW_TABLE_ID=

# Image delivery. BaseRow File columns serve the original upload, so HEIC/RAW
# photos will not render in Chrome/Firefox and can be several MB each. Setting
# this to "cloudinary" re-delivers every kit photo through the Cloudinary
# fetch transform below (format + resize). Use "off" for the raw BaseRow URLs.
VITE_BASEROW_CDN=cloudinary
VITE_BASEROW_IMAGE_WIDTH=800

# ---------------------------------------------------------------------------
# Delivery fees — read from a second BaseRow table so they can change without a
# redeploy. One row per area, in the SAME database (the same token is reused):
#   Location | Fee | Is Default
#   Nairobi  | 200 | [x]
#   Mombasa  | 450 | [ ]
# Recognised columns (case/space/underscore insensitive):
#   Location | Area | Town | City | County | Region | Zone
#   Fee | Delivery Fee | Charge | Price | Amount
#   Is Default | Default | Fallback      (optional; the area charged when the
#                                         shopper picks nothing)
# A far area simply gets a higher Fee — there is no surcharge arithmetic.
# VITE_DELIVERY_TABLE_ID empty: no area picker is shown and every delivery order
# pays VITE_DELIVERY_FEE. Pick-up-at-shop orders are always free.
# Restart the dev server after changing either value.
VITE_DELIVERY_TABLE_ID=
VITE_DELIVERY_FEE=200
# If the kits token is table-scoped it will 401 on the delivery table. Issue a
# second token (BaseRow -> avatar -> Menu -> API) and put it here; leave unset to
# reuse VITE_BASEROW_API_KEY.
VITE_DELIVERY_TOKEN=

# ---------------------------------------------------------------------------
# Orders — every checkout is saved as a new row so the shop can track them.
# Create an ORDERS table in the SAME BaseRow database with any of these columns
# (matched case/space/underscore insensitively):
#   Order Ref | Ref | Reference | Order No          (text)
#   Name | Full Name | Customer Name                (text)
#   Phone | Mobile | M-PESA Number                  (text or number)
#   Items | Order Items | Kits | Products           (long text)
#   Amount | Total | Paid                           (number)
#   Fulfillment | Delivery Method | Type            (text; Delivery / Pickup)
#   Area | Location | Town | Zone                   (text)
#   Note | Notes | Comment | Landmark               (text, optional)
#   Account | Email                                 (text, optional)
#   Placed At | Date | Created                      (date, optional)
# The token must have WRITE access to this table; scope it to the table only.
# Left blank = orders are not saved (checkout still works).
VITE_ORDERS_TABLE_ID=
VITE_ORDERS_TOKEN=

# ---------------------------------------------------------------------------
# Cloudinary — kit image CDN for BaseRow photos, and the fallback listing
# source when BaseRow is unset or returns nothing.
# Set VITE_CLOUDINARY_CLOUD_NAME
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_TAG=retro

# WhatsApp enquiries floating button: country code + number, no '+' or spaces
# e.g. VITE_WHATSAPP_NUMBER=254712345678
VITE_WHATSAPP_NUMBER=